# Copy to link.env (kept private: chmod 600) and fill in. Never share link.env.
DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID
# OAuth2 › Reset Secret in the Discord Developer Portal; paste it here yourself, never in chat
DISCORD_CLIENT_SECRET=
# This service's public address + /callback. Testing on this Mac only: http://127.0.0.1:8787/callback
REDIRECT_URI=http://127.0.0.1:8787/callback
# The public launch date, e.g. 2027-03-01T00:00:00Z. Empty = before launch: everyone who plays is a Founder.
FOUNDER_CUTOFF=
# Bot › Reset Token: lets the service add signed-in players to the community server and give their roles. Paste it here yourself.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=1563514591156375645
PORT=8787
HOST=127.0.0.1
# Players in a web browser (the game server's own web link): the game server's sign-in secret (the text of the file its
# RM_WEB_SECRET_FILE names; tools/web_token.py --new-secret makes one) and the game servers /play may send players back
# to, comma-separated (e.g. https://play.example.com). Empty: /play is off.
GAME_TOKEN_SECRET=
GAME_URLS=

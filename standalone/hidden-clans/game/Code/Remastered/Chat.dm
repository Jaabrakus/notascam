// 1 to send this line, 0 to drop it. text: the line as the player would read it (no HTML tags).
proc/RemasterChatKeep(text)
	text = "[text]"
	var/n = length(text)
	for(var/list/D in rm_chat_drop)
		var/p = D[3]
		if(D[2] == "end")
			if(n >= length(p) && copytext(text, n - length(p) + 1) == p) return 0
		else if(D[2] == "all")
			var/all = 1
			for(var/x in p) if(!findtextEx(text, x)) all = 0
			if(all) return 0
		else if(findtextEx(text, p)) return 0
	if(rm_chat_group_unit) return RmChatGroupTake(text)   // a group action's own reply: counted, one line at the end (ChatGroup.dm)
	return 1

// Big hits on the limbs (the user: "each new stage"): a blow that takes a limb to a worse stage than it was in (Broken at
// 60 health or less: it can't be used; Crushed at 40; Mangled at 10; lost) says so once, naming the worst stage it
// reached and who struck it, to the struck unit's owner, the striker's and the players whose camera is near.
var/list/rm_limb_parts = list("LeftArm"="left arm", "RightArm"="right arm", "LeftLeg"="left leg", "RightLeg"="right leg")
var/list/rm_limb_verbs = list("breaks", "crushes", "mangles", "cuts off")
#define RM_LIMB_NEAR 15     // tiles from the struck unit a player's camera may be and still hear of it

#define RM_LIMB_RANK(X) ((X) <= 10 ? 3 : (X) <= 40 ? 2 : (X) <= 60 ? 1 : 0)
proc/RmLimbRank(mob/M, part)
	if(ismob(M))   // a limb's own fields (combat-speed, 10-26: by name it cost ~1 us each, 8 a blow in the chat step)
		switch(part)
			if("LeftArm") return M.HasLeftArm ? RM_LIMB_RANK(M.LeftArmHP) : 4
			if("RightArm") return M.HasRightArm ? RM_LIMB_RANK(M.RightArmHP) : 4
			if("LeftLeg") return M.HasLeftLeg ? RM_LIMB_RANK(M.LeftLegHP) : 4
			if("RightLeg") return M.HasRightLeg ? RM_LIMB_RANK(M.RightLegHP) : 4
	if(!M || !(("[part]HP") in M.vars)) return 0
	if(!M.vars["Has[part]"]) return 4
	var/hp = M.vars["[part]HP"]
	return hp <= 10 ? 3 : hp <= 40 ? 2 : hp <= 60 ? 1 : 0

proc/RmChatName(mob/M)
	return istype(M, /mob/Monsters) ? M:RemasterBareName() : "[M]"

// mob/RemasterStrike: this file's part is step RmChainStrike_Chat in Code/Remastered/Chains/Strike.dm

// To the struck unit's owner, the striker's, and the players whose camera is near (a mob proc: a check records the lines).
mob/proc/RmLimbSay(mob/by, line)
	var/list/to_whom = list()
	for(var/mob/O in list(Owner, by ? by.Owner : null)) if(istype(O, /Player) && O.client) to_whom |= O
	for(var/Player/P in Players) if(P.client && P.z == z && get_dist(P, src) <= RM_LIMB_NEAR) to_whom |= P
	for(var/Player/P in to_whom) P << line
